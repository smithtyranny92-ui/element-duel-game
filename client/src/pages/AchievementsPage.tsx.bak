import { motion } from 'framer-motion';
import { useGame } from '../contexts/GameContext';

interface Props {
  onBack: () => void;
}

function AchievementGlyph({ unlocked }: { unlocked: boolean }) {
  return (
    <span
      style={{
        color: unlocked ? 'rgba(255,255,255,0.88)' : 'rgba(255,255,255,0.45)',
        fontSize: '1.2rem',
        lineHeight: 1,
      }}
    >
      ✡
    </span>
  );
}

export default function AchievementsPage({ onBack }: Props) {
  const { achievements } = useGame();

  const sortedAchievements = [
    ...achievements.filter(item => item.unlocked),
    ...achievements.filter(item => !item.unlocked),
  ];

  return (
    <div className="relative overflow-hidden" style={{ width: '100%', height: '100%', minHeight: '100%', background: '#05090c' }}>
      <div
        className="absolute inset-0"
        style={{
          backgroundImage: "url('/bg-menu.jpg')",
          backgroundSize: 'cover',
          backgroundPosition: 'center',
          transform: 'scale(1.03)',
        }}
      />
      <div
        className="absolute inset-0"
        style={{
          background: 'linear-gradient(180deg, rgba(0,0,0,0.68) 0%, rgba(2,10,14,0.72) 45%, rgba(1,9,13,0.84) 100%)',
        }}
      />

      <div className="relative z-10 px-4 pt-5 pb-8" style={{ minHeight: '100%' }}>
        <div className="flex items-center justify-center relative pb-5">
          <button
            onClick={onBack}
            className="absolute left-0 top-0"
            style={{
              background: 'transparent',
              border: 'none',
              color: 'rgba(255,255,255,0.94)',
              fontSize: '2rem',
              lineHeight: 1,
            }}
          >
            ←
          </button>
          <div
            style={{
              color: '#ffffff',
              fontSize: '1.4rem',
              fontWeight: 400,
              letterSpacing: '0.02em',
            }}
          >
            成就堂
          </div>
        </div>

        <div className="space-y-4 pt-2">
          {sortedAchievements.map((achievement, index) => (
            <motion.div
              key={achievement.id}
              initial={{ opacity: 0, y: 18 }}
              animate={{ opacity: achievement.unlocked ? 1 : 0.76, y: 0 }}
              transition={{ delay: index * 0.04 }}
              style={{
                minHeight: 60,
                borderRadius: 999,
                background: 'rgba(35, 42, 42, 0.82)',
                border: '1px solid rgba(255,255,255,0.05)',
                padding: '14px 18px',
                display: 'flex',
                alignItems: 'center',
                gap: 14,
              }}
            >
              <div style={{ width: 20, display: 'flex', justifyContent: 'center' }}>
                <AchievementGlyph unlocked={achievement.unlocked} />
              </div>

              <div className="min-w-0 flex-1">
                <div
                  style={{
                    color: achievement.unlocked ? 'rgba(255,255,255,0.92)' : 'rgba(255,255,255,0.62)',
                    fontSize: '0.98rem',
                    fontWeight: 500,
                  }}
                >
                  {achievement.title}
                </div>
                <div
                  style={{
                    color: 'rgba(255,255,255,0.42)',
                    fontSize: '0.72rem',
                    lineHeight: 1.5,
                    marginTop: 2,
                  }}
                >
                  {achievement.description}
                </div>
              </div>
            </motion.div>
          ))}
        </div>
      </div>
    </div>
  );
}
