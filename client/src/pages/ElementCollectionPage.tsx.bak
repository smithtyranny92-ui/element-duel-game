function getSkillLabel(card: ElementCard) {
  const labels: Record<string, string> = {
    none: '无主动技能',
    catalyze: '催化连段',
    reveal: '揭示护甲',
    neutralize: '中和/碱性处理',
    corrode: '腐蚀/酸性处理',
    shield: '生成护盾',
    recover: '回复/衍生',
  };
  return labels[card.skill] ?? '特殊技能';
}

function buildDetail(card: ElementCard): CompendiumDetail {
  const override = DETAIL_OVERRIDES[card.id];
  if (override) return override;

  const familyName = FAMILY_NAMES[card.family] ?? '元素';
  const breaksArmor = card.breaksArmor?.length ? `可关联护甲：${card.breaksArmor.join('、')}` : '当前版本暂无明确护甲列表，主要作为通用知识或辅助牌使用。';

  return {
    summary: `${card.name} 属于${familyName}，在本作中更偏向${getSkillLabel(card)}与基础反应学习。`,
    reaction: card.equation || card.reactionEquation || '当前图鉴尚未为该条目补入专属方程式，但已纳入完整分类浏览。',
    usage: `${breaksArmor} 基础伤害为 ${card.coreDamage}，适合与同族或相邻知识点一起记忆。`,
    tags: [familyName, getSkillLabel(card), `伤害 ${card.coreDamage}`],
  };
}

function ElementBadge({ text }: { text: string }) {
  return (
    <span
      style={{
        padding: '4px 10px',
        borderRadius: 999,
        border: '1px solid rgba(255,255,255,0.12)',
        background: 'rgba(255,255,255,0.06)',
        color: 'rgba(255,255,255,0.84)',
        fontSize: '0.72rem',
        fontWeight: 600,
      }}
    >
      {text}
    </span>
  );
}

export default function ElementCollectionPage({ onBack }: Props) {
  const cards = useMemo(
    () => ELEMENT_ORDER.map((id) => CARD_MAP[id]).filter(Boolean),
    []
  );

  const [selectedFamily, setSelectedFamily] = useState<string>('all');
  const [selectedId, setSelectedId] = useState<string>(cards[0]?.id ?? 'H2');

  const familyCounts = useMemo(() => {
    const counter: Record<string, number> = {};
    cards.forEach((card) => {
      counter[card.family] = (counter[card.family] ?? 0) + 1;
    });
    return counter;
  }, [cards]);

  const visibleCards = useMemo(() => {
    return selectedFamily === 'all'
      ? cards
      : cards.filter((card) => card.family === selectedFamily);
  }, [cards, selectedFamily]);

  const selectedCard = visibleCards.find((card) => card.id === selectedId) ?? cards.find((card) => card.id === selectedId) ?? cards[0];
  const selectedDetail = buildDetail(selectedCard);
  const familyColor = FAMILY_COLORS[selectedCard.family] ?? FAMILY_COLORS.compound;

  return (
    <div
      className="relative h-full overflow-hidden"
      style={{
        width: '100%',
        height: '100%',
        minHeight: '100%',
        background: 'linear-gradient(180deg, #041018 0%, #07161f 48%, #050c12 100%)',
        color: '#fff',
      }}
    >
      <div
        className="absolute inset-0"
        style={{
          background: 'radial-gradient(circle at 50% 14%, rgba(34,211,238,0.14) 0%, transparent 28%), radial-gradient(circle at 82% 78%, rgba(59,130,246,0.10) 0%, transparent 26%)',
          pointerEvents: 'none',
        }}
      />

      <div className="relative z-10 h-full flex flex-col" style={{ minHeight: '100%' }}>
        <div className="flex items-center justify-between px-4 pt-5 pb-3">
          <button
            onClick={onBack}
            style={{
              width: 38,
              height: 38,
              borderRadius: 12,
              border: '1px solid rgba(255,255,255,0.12)',
              background: 'rgba(255,255,255,0.05)',
              color: 'rgba(255,255,255,0.88)',
              fontSize: '1rem',
            }}
          >
            ←
          </button>

          <div style={{ textAlign: 'center' }}>
            <div style={{ fontSize: '1.16rem', fontWeight: 800, letterSpacing: '0.08em' }}>元素图鉴</div>
            <div style={{ fontSize: '0.68rem', color: 'rgba(255,255,255,0.48)', marginTop: 2 }}>ELEMENT COMPENDIUM</div>
          </div>

          <div
            style={{
              minWidth: 54,
              height: 30,
              borderRadius: 999,
              background: 'rgba(34,211,238,0.10)',
              border: '1px solid rgba(34,211,238,0.18)',
              color: '#a5f3fc',
              fontSize: '0.72rem',
              fontWeight: 700,
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
            }}
          >
            {cards.length} 项
          </div>
        </div>

        <div className="px-4">
          <div
            style={{
              borderRadius: 22,
              padding: '14px 14px 12px',
              background: 'linear-gradient(180deg, rgba(9,21,30,0.92) 0%, rgba(7,16,24,0.88) 100%)',
              border: '1px solid rgba(255,255,255,0.08)',
              boxShadow: '0 16px 36px rgba(0,0,0,0.26)',
            }}
          >
            <div style={{ display: 'flex', alignItems: 'center', gap: 12 }}>
              <div
                style={{
                  width: 56,
                  height: 56,
                  borderRadius: 18,
                  display: 'flex',
                  alignItems: 'center',
                  justifyContent: 'center',
                  background: `linear-gradient(180deg, ${familyColor.primary}33 0%, ${familyColor.secondary}26 100%)`,
                  border: `1px solid ${familyColor.primary}44`,
                  color: familyColor.primary,
                  fontSize: '1.6rem',
                  fontWeight: 900,
                  boxShadow: `0 0 18px ${familyColor.glow}22`,
                }}
              >
                {selectedCard.symbol}
              </div>
              <div style={{ minWidth: 0 }}>
                <div style={{ fontSize: '1rem', fontWeight: 800, color: 'rgba(255,255,255,0.94)' }}>{selectedCard.name}</div>
                <div style={{ fontSize: '0.72rem', color: 'rgba(255,255,255,0.48)', marginTop: 2 }}>{FAMILY_NAMES[selectedCard.family] ?? '元素'} · {selectedCard.id}</div>
              </div>
            </div>

            <div style={{ marginTop: 12, color: 'rgba(255,255,255,0.78)', fontSize: '0.78rem', lineHeight: 1.7 }}>
              {selectedDetail.summary}
            </div>

            <div style={{ display: 'flex', flexWrap: 'wrap', gap: 8, marginTop: 12 }}>
              <ElementBadge text={`基础伤害 ${selectedCard.coreDamage}`} />
              <ElementBadge text={getSkillLabel(selectedCard)} />
              {selectedDetail.tags.slice(0, 2).map((tag) => (
                <ElementBadge key={tag} text={tag} />
              ))}
            </div>
          </div>
        </div>

        <div className="px-4 pt-3">
          <div style={{ display: 'flex', gap: 8, overflowX: 'auto', paddingBottom: 2 }}>
            <button
              onClick={() => setSelectedFamily('all')}
              style={{
                flexShrink: 0,
                padding: '7px 12px',
                borderRadius: 999,
                border: '1px solid rgba(255,255,255,0.10)',
                background: selectedFamily === 'all' ? 'rgba(255,255,255,0.14)' : 'rgba(255,255,255,0.04)',
                color: 'rgba(255,255,255,0.86)',
                fontSize: '0.72rem',
                fontWeight: 700,
              }}
            >
              全部 {cards.length}
            </button>
            {FAMILY_ORDER.filter((family) => familyCounts[family]).map((family) => (
              <button
                key={family}
                onClick={() => {
                  setSelectedFamily(family);
                  const nextCard = cards.find((card) => card.family === family);
                  if (nextCard) setSelectedId(nextCard.id);
                }}
                style={{
                  flexShrink: 0,
                  padding: '7px 12px',
                  borderRadius: 999,
                  border: '1px solid rgba(255,255,255,0.10)',
                  background: selectedFamily === family ? 'rgba(255,255,255,0.14)' : 'rgba(255,255,255,0.04)',
                  color: 'rgba(255,255,255,0.82)',
                  fontSize: '0.72rem',
                  fontWeight: 700,
                }}
              >
                {FAMILY_NAMES[family]} {familyCounts[family]}
              </button>
            ))}
          </div>
        </div>

        <div className="px-4 pt-3 pb-4 overflow-y-auto" style={{ flex: 1 }}>
          <div
            style={{
              borderRadius: 22,
              padding: '14px',
              background: 'rgba(8,15,22,0.82)',
              border: '1px solid rgba(255,255,255,0.08)',
            }}
          >
            <div style={{ color: 'rgba(255,255,255,0.36)', fontSize: '0.68rem', letterSpacing: '0.12em', textTransform: 'uppercase' }}>
              分类说明
            </div>
            <div style={{ color: 'rgba(255,255,255,0.76)', fontSize: '0.76rem', lineHeight: 1.7, marginTop: 8 }}>
              {selectedFamily === 'all'
                ? '图鉴已补齐为完整可浏览页。你可以先按分类筛选，再点开任意条目查看核心反应、用途与记忆标签。'
                : FAMILY_DESCRIPTIONS[selectedFamily]}
            </div>
          </div>

          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(2, minmax(0, 1fr))', gap: 10, marginTop: 12 }}>
            {visibleCards.map((card) => {
              const colors = FAMILY_COLORS[card.family] ?? FAMILY_COLORS.compound;
              const active = card.id === selectedCard.id;
              return (
                <button
                  key={card.id}
                  onClick={() => setSelectedId(card.id)}
                  style={{
                    textAlign: 'left',
                    borderRadius: 18,
                    padding: '12px 12px 11px',
                    border: active ? `1px solid ${colors.primary}66` : '1px solid rgba(255,255,255,0.08)',
                    background: active
                      ? `linear-gradient(180deg, ${colors.primary}22 0%, rgba(8,16,24,0.92) 100%)`
                      : 'linear-gradient(180deg, rgba(12,22,30,0.92) 0%, rgba(7,14,21,0.92) 100%)',
                    boxShadow: active ? `0 0 18px ${colors.glow}24` : 'none',
                  }}
                >
                  <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: 8 }}>
                    <div style={{ color: colors.primary, fontSize: '1.4rem', fontWeight: 900, lineHeight: 1 }}>{card.symbol}</div>
                    <div
                      style={{
                        minWidth: 28,
                        height: 22,
                        borderRadius: 999,
                        background: 'rgba(255,255,255,0.08)',
                        color: 'rgba(255,255,255,0.66)',
                        display: 'flex',
                        alignItems: 'center',
                        justifyContent: 'center',
                        fontSize: '0.68rem',
                        fontWeight: 700,
                      }}
                    >
                      {card.coreDamage}
                    </div>
                  </div>
                  <div style={{ marginTop: 8, color: 'rgba(255,255,255,0.92)', fontSize: '0.84rem', fontWeight: 700 }}>{card.name}</div>
                  <div style={{ marginTop: 4, color: 'rgba(255,255,255,0.46)', fontSize: '0.68rem' }}>{FAMILY_NAMES[card.family]}</div>
                </button>
              );
            })}
          </div>

          <div
            style={{
              marginTop: 14,
              borderRadius: 22,
              padding: '14px',
              background: 'linear-gradient(180deg, rgba(8,18,28,0.96) 0%, rgba(5,11,18,0.96) 100%)',
              border: '1px solid rgba(255,255,255,0.08)',
            }}
          >
            <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: 12 }}>
              <div>
                <div style={{ color: 'rgba(255,255,255,0.92)', fontWeight: 800, fontSize: '0.94rem' }}>核心反应</div>
                <div style={{ color: 'rgba(255,255,255,0.34)', fontSize: '0.66rem', marginTop: 2 }}>REACTION NOTE</div>
              </div>
              <ElementBadge text={selectedCard.id} />
            </div>

            <div
              style={{
                marginTop: 12,
                borderRadius: 16,
                padding: '12px 12px 10px',
                background: 'rgba(255,255,255,0.04)',
                border: '1px solid rgba(255,255,255,0.06)',
              }}
            >
              <div style={{ color: '#a5f3fc', fontSize: '0.8rem', fontWeight: 700, lineHeight: 1.7 }}>{selectedDetail.reaction}</div>
            </div>

            <div style={{ marginTop: 12, color: 'rgba(255,255,255,0.78)', fontSize: '0.78rem', lineHeight: 1.75 }}>
              {selectedDetail.usage}
            </div>

            <div style={{ display: 'flex', flexWrap: 'wrap', gap: 8, marginTop: 12 }}>
              {selectedDetail.tags.map((tag) => (
                <ElementBadge key={tag} text={tag} />
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}
